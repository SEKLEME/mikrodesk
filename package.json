{
  "name": "mikrodesk",
  "productName": "MikroDesk",
  "version": "1.1.0",
  "description": "MikroDesk — gestion de routeur MikroTik via son API : hotspot, vouchers, PPP, interfaces et supervision temps réel.",
  "main": "main.js",
  "author": "VTECHGROUP",
  "license": "MIT",
  "scripts": {
    "start": "electron .",
    "dev": "electron . --dev",
    "pack": "electron-builder --dir",
    "dist": "electron-builder --win portable nsis"
  },
  "dependencies": {
    "node-routeros": "^1.6.9"
  },
  "devDependencies": {
    "electron": "^45.3.2",
    "electron-builder": "^26.0.12",
    "playwright-core": "^1.55.0"
  },
  "build": {
    "appId": "com.vtechgroup.mikrodesk",
    "productName": "MikroDesk",
    "directories": {
      "output": "release"
    },
    "files": [
      "main.js",
      "preload.js",
      "src/**/*",
      "renderer/**/*",
      "package.json"
    ],
    "win": {
      "target": [
        "portable",
        "nsis"
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "shortcutName": "MikroDesk"
    }
  }
}
